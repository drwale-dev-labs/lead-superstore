# SUPABASE CONFIG
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ENVIRONMENT CONFIG
ENVIRONMENT=development

# CORS CONFIG (comma-separated origins allowed to call this API)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# SENTRY CONFIG (leave blank to disable error monitoring)
SENTRY_DSN=

# ANTHROPIC KEY
ANTHROPIC_API_KEY=

# PAYSTACK CONFIG
PAYSTACK_SECRET_KEY=

# ECOMMERCE CONFIG
ECOMMERCE_URL=http://localhost:3001

# RESEND CONFIG
RESEND_API_KEY=

# AFRICA'S TALKING CONFIG (sandbox — replace with production creds when ready)
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_SENDER_ID=Lead Superstore
